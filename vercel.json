{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/projects/:slug",
      "destination": "/work/:slug",
      "permanent": true
    },
    {
      "source": "/articles/leverage-fullstory-dxi-data-driven-design-v7",
      "destination": "/articles/leverage-fullstory-dxi-data-driven-design",
      "permanent": true
    },
    {
      "source": "/loading-preview",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/work/sbt-films",
      "destination": "/work/sbt-brand-launch",
      "permanent": true
    },
    {
      "source": "/work/sbt-films.html",
      "destination": "/work/sbt-brand-launch",
      "permanent": true
    },
    {
      "source": "/work/reference-to-motion-film",
      "destination": "/work/reference-to-motion-teaser",
      "permanent": true
    },
    {
      "source": "/work/reference-to-motion-film.html",
      "destination": "/work/reference-to-motion-teaser",
      "permanent": true
    },
    {
      "source": "/work/mint-film",
      "destination": "/work/mint-video",
      "permanent": true
    },
    {
      "source": "/work/mint-film.html",
      "destination": "/work/mint-video",
      "permanent": true
    }
  ]
}
