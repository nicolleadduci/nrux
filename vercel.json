{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/projects/:slug",
      "destination": "/work/:slug",
      "permanent": true
    },
    {
      "source": "/articles/leverage-fullstory-dxi-data-driven-design-v7",
      "destination": "/articles/leverage-fullstory-dxi-data-driven-design",
      "permanent": true
    },
    {
      "source": "/loading-preview",
      "destination": "/",
      "permanent": true
    }
  ]
}
